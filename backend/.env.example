# Copy to backend/.env. Supply private values locally; never commit .env.
PORT=5001
NODE_ENV=development
JWT_SECRET=
JWT_EXPIRES_IN=1h
DATABASE_URL=
CORS_ORIGIN=http://localhost:5173,http://localhost:4173
APP_URL=http://localhost:5173
APP_NAME=DevNexus AI
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
REFRESH_TOKEN_TTL_HOURS=168
PASSWORD_RESET_MINUTES=30
# Console mode logs email content; disposable local demo accounts only.
SMTP_MODE=console
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@example.com
DEMO_VERIFICATION_CODE=
# Server-side provider credentials only. Model must be available to your key.
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_API_KEY_2=
GEMINI_MODEL=
GEMINI_TIMEOUT_MS=90000
AI_MULTI_PROVIDER_CHAT_ENABLED=false
GROK_API_KEY_1=
GROK_API_KEY_2=
GROK_API_KEY_3=
GROK_MODEL=
GROK_TIMEOUT_MS=60000
# Optional external integrations; not bundled services.
AI_SERVICE_URL=
AI_SERVICE_TIMEOUT_MS=15000
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_TIMEOUT_MS=30000
